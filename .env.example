# Telecel AskHR - SMTP settings for email notifications
# Copy this file to .env and fill in your real values.

# SMTP server (e.g. smtp.gmail.com, smtp.office365.com, smtp.telecelgh.com)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=sirmichaelawuku@gmail.com
SMTP_PASS=your-gmail-app-password

# Sender shown on emails (defaults to SMTP_USER if empty)
MAIL_FROM=Telecel AskHR <sirmichaelawuku@gmail.com>

# Comma-separated inbox(es) the HR support team receives new tickets in
HR_EMAIL=sirmichaelawuku@gmail.com

# Port for the web app
PORT=3000
